{
  "name": "boilerplate",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/boilerplate",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project boilerplate --web",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/apps/boilerplate/.next/!(cache)/**/*",
        "{workspaceRoot}/apps/boilerplate/.next/!(cache)"
      ],
      "options": {
        "cwd": "apps/boilerplate",
        "command": "next build --webpack"
      }
    },
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/boilerplate",
        "command": "next dev --webpack"
      }
    }
  }
}
